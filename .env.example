# ─────────────────────────────────────────────────────────────
# Trencher configuration. Copy this file to `.env` and fill it in.
# NEVER commit your real `.env` — it contains your private key.
# ─────────────────────────────────────────────────────────────

# Solana RPC endpoint. A private/paid RPC (Helius, Triton, QuickNode...)
# is strongly recommended for trading — the public RPC is rate limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Trencher's wallet PUBLIC key (used for read-only balance/portfolio checks).
WALLET_PUBLIC_KEY=7Q67jA54qLFVaDyZDUGYRXbFyc6w2qE9MvgSwaXSV2hK

# Trencher's wallet PRIVATE key, required ONLY to actually sign/send trades.
# Accepts a base58 string (Phantom export) or a JSON array of bytes.
# Leave empty to run in read-only / dry-run mode.
WALLET_PRIVATE_KEY=

# Trading guardrails -------------------------------------------------
# Default buy size per trade, in SOL.
TRADE_SIZE_SOL=0.05
# Max slippage tolerated on a swap, in basis points (100 = 1%).
SLIPPAGE_BPS=100
# Take profit / stop loss as percentages of entry price.
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=25
# Hard cap on how much SOL the agent is allowed to deploy in total.
MAX_SOL_EXPOSURE=0.5
# When true, the agent never sends real transactions (simulation only).
DRY_RUN=true

# Optional: override the Jupiter swap API base. Defaults to the free "lite" host.
# Use https://api.jup.ag/swap/v1 together with an API key for higher limits.
# JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
