# Required for LLM synthesis
OPENAI_API_KEY=

# Optional model override (defaults to gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Search provider selector: tavily | serpapi | brave | exa
SEARCH_PROVIDER=tavily

# Search provider API keys (set the one matching SEARCH_PROVIDER)
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# Optional tuning
RESEARCH_RESULT_LIMIT=8
