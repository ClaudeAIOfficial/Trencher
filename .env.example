# ── Required ──────────────────────────────────────────────────────────────────
# OpenAI API key — used for GPT-4o Vision (image analysis) and text synthesis
OPENAI_API_KEY=sk-...

# ── Optional ──────────────────────────────────────────────────────────────────
# SerpAPI key — enables richer Google search results (google.com/apis/serpapi)
# If not set, the app uses DuckDuckGo (free, no key required)
# SERP_API_KEY=...
