# ============================================================
# Research Agent — Environment Variables
# Copy this file to .env.local and fill in your API keys.
# ============================================================

# ---- REQUIRED: OpenAI (for AI analysis and report generation) ----
OPENAI_API_KEY=sk-...

# ---- REQUIRED: At least one Search API ----
# The app auto-detects which key is present (priority order below).
# You only need ONE of these.

# Option 1: Tavily (recommended — best for AI research)
# Get key: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Option 2: Brave Search
# Get key: https://brave.com/search/api
# BRAVE_API_KEY=BSA...

# Option 3: SerpAPI (Google Search)
# Get key: https://serpapi.com
# SERP_API_KEY=...

# Option 4: Exa (neural search)
# Get key: https://exa.ai
# EXA_API_KEY=...

# ---- OPTIONAL ----
# Override the default OpenAI model (default: gpt-4o-mini)
# Use gpt-4o for higher quality reports (costs more)
# OPENAI_MODEL=gpt-4o
